# Supabase project URL and publishable key (Settings > API Keys). Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: preserve the phase-1 local demo during development only. Never enables local fallback in production.
# NEXT_PUBLIC_DATA_MODE=local

# Optional server-only Supabase admin client for background jobs, full backup restore,
# and per-store DeepSeek key access. Prefer the Vercel Supabase integration variable.
# CRON_SECRET=generate_a_long_random_value
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional server-side fallback key for DeepSeek. Prefer configuring per-store in Settings.
# Never use NEXT_PUBLIC_ prefix. Per-store API keys are stored in the Supabase server-only table.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
