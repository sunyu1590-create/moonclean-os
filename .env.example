# Supabase project URL and publishable key (Settings > API Keys). Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: preserve the phase-1 local demo during development only. Never enables local fallback in production.
# NEXT_PUBLIC_DATA_MODE=local
