# Supabase project URL and publishable key (Settings > API Keys). Safe to expose to the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: preserve the phase-1 local demo during development only. Never enables local fallback in production.
# NEXT_PUBLIC_DATA_MODE=local

# Optional server-only mock scheduler on Vercel. Never prefix these with NEXT_PUBLIC_.
# CRON_SECRET=generate_a_long_random_value
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional server-only DeepSeek AI after-sales summaries. Never use NEXT_PUBLIC_ prefix.
# Obtain the key from DeepSeek and configure it in the deployment environment.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
